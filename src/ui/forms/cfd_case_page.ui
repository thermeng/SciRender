        <property name="text"><string>Cancel</string></property>
        <property name="enabled"><bool>false</bool></property>
        <property name="toolTip"><string>Stop the run at the next step boundary. The current step is completed so the saved state is a valid restart point.</string></property>
        <property name="sizePolicy">
         <sizepolicy hsizetype="Expanding" vsizetype="Fixed">
          <horstretch>1</horstretch>
          <verstretch>0</verstretch>
